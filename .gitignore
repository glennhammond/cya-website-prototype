# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Provisional image library: large (300MB+), unapproved for publication, and
# includes images with unverified/undocumented consent (see
# Docs/CYA_Prototype_v1_Image_Audit.md). Only the curated, cropped
# derivatives in public/images/selected/ are committed.
/public/images/source/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
